# SupportMind AI Environment Configuration

# Primary Cloud LLM Provider: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Open-Model Alternative: GPT-OSS (Hosted via Groq or OpenAI-compatible provider)
GPT_OSS_API_KEY=
GPT_OSS_BASE_URL=https://api.groq.com/openai/v1
GPT_OSS_MODEL=openai/gpt-oss-20b

# Active provider: "gemini" or "gpt_oss"
ACTIVE_LLM_PROVIDER=gemini

# Database
DATABASE_URL=sqlite:///./backend/supportmind.db
